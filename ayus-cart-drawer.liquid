<!-- Quick Add Modal -->
<div class="tt-qa-overlay" id="tt-qa-overlay" onclick="closeQuickAdd()"></div>
<div class="tt-qa-drawer" id="tt-qa-drawer">
  <button class="tt-qa-close" onclick="closeQuickAdd()">&times;</button>
  <div class="tt-qa-header-product" id="tt-qa-header-product">
    <!-- Populated by JS -->
  </div>
  <div class="tt-qa-body" id="tt-qa-variants">
    <div style="text-align:center; padding: 20px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; color: #888;">Loading...</div>
  </div>
</div>
<style>
  .tt-qa-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999998; opacity: 0; visibility: hidden; transition: 0.3s; }
  .tt-qa-overlay.active { opacity: 1; visibility: visible; }
  .tt-qa-drawer { position: fixed; bottom: -100%; left: 0; width: 100%; background: #faf8f5; z-index: 9999999; padding: 30px 24px; border-top-left-radius: 20px; border-top-right-radius: 20px; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 -5px 20px rgba(0,0,0,0.1); max-height: 85vh; overflow-y: auto; display: flex; flex-direction: column; }
  .tt-qa-drawer.active { bottom: 0; }
  
  .tt-qa-close { position: absolute; top: 15px; right: 15px; background: transparent; border: none; font-size: 32px; font-weight: 300; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--color-text); padding: 0; margin: 0; line-height: 1; z-index: 2; box-shadow: none; border-radius: 0; }
  
  .tt-qa-header-product { margin-bottom: 25px; padding-bottom: 25px; border-bottom: 1px solid rgba(0,0,0,0.05); padding-right: 20px; }
  .tt-qa-product-link { display: flex; gap: 20px; align-items: flex-start; width: 100%; color: inherit; text-decoration: none; cursor: pointer; }
  .tt-qa-product-link:hover { opacity: 0.85; }
  .tt-qa-prod-img { width: 90px; height: 90px; object-fit: cover; border: 1px solid var(--color-border); border-radius: 4px; }
  .tt-qa-prod-info { flex-grow: 1; }
  .tt-qa-prod-vendor { font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #777; margin-bottom: 6px; display: block; }
  .tt-qa-prod-title { font-family: var(--font-body); font-size: 18px; margin: 0 0 8px 0; color: var(--color-text); line-height: 1.2; font-weight: bold; }
  .tt-qa-prod-desc { font-size: 13px; color: #666; margin: 0; line-height: 1.4; }
  .tt-qa-view-product { display: inline-flex; align-items: center; margin-top: 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); text-decoration: underline; text-underline-offset: 4px; }

  .tt-qa-meta { display: flex; align-items: baseline; gap: 10px; margin-bottom: 18px; }
  .tt-qa-price { font-family: var(--font-body); font-size: 20px; letter-spacing: 0.04em; color: var(--color-text); }
  .tt-qa-tax { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.1em; }
  .tt-qa-size-label { display: block; margin-bottom: 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: #777; }
  .tt-qa-variant-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
  .tt-qa-variant-pill { display: inline-block; padding: 10px 20px; border: 1px solid var(--color-border); background-color: transparent; color: var(--color-text); font-family: var(--font-body); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: all 0.3s ease; }
  .tt-qa-variant-pill.is-active { background-color: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .tt-qa-variant-pill.is-disabled { opacity: 0.6; }
  .tt-qa-add-btn { width: 100%; background-color: var(--color-accent); color: #fff; border: 1px solid var(--color-accent); padding: 14px 18px; text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px; font-family: var(--font-body); cursor: pointer; transition: opacity 0.3s ease; }
  .tt-qa-add-btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>
<script>
  let currentQuickAddVariantId = null;

  function formatQuickAddMoney(cents) {
    return 'Rs. ' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function closeQuickAdd() {
    document.getElementById('tt-qa-overlay').classList.remove('active');
    document.getElementById('tt-qa-drawer').classList.remove('active');
    currentQuickAddVariantId = null;
  }

  function syncQuickAddVariantUI(button) {
    if (!button) return;

    currentQuickAddVariantId = Number(button.dataset.variantId);

    document.querySelectorAll('.tt-qa-variant-pill').forEach(pill => {
      pill.classList.remove('is-active');
    });
    button.classList.add('is-active');

    const priceEl = document.getElementById('tt-qa-current-price');
    if (priceEl && button.dataset.price) {
      priceEl.textContent = formatQuickAddMoney(Number(button.dataset.price));
    }

    const addBtn = document.getElementById('tt-qa-add-btn');
    if (addBtn) {
      const available = button.dataset.available === 'true';
      addBtn.disabled = !available;
      addBtn.textContent = available ? 'Add To Bag' : 'Sold Out';
    }
  }

  function openQuickAddModal(handle) {
    document.getElementById('tt-qa-header-product').innerHTML = '';
    document.getElementById('tt-qa-variants').innerHTML = '<div style="text-align:center; padding: 20px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; color: #888;">Loading...</div>';
    document.getElementById('tt-qa-overlay').classList.add('active');
    document.getElementById('tt-qa-drawer').classList.add('active');
    
    fetch('/products/' + handle + '.js')
      .then(r => r.json())
      .then(product => {
        // Build Header
        let imgUrl = product.featured_image || '';
        let vendor = product.vendor || 'Tulsi Tales';
        let title = product.title.split('-').pop().trim();
        // Strip HTML from description for a short excerpt
        let descHtml = product.description || '';
        let descText = descHtml;
        
        let headerHtml = '';
        let productUrl = '/products/' + product.handle;
        headerHtml += '<a href="' + productUrl + '" class="tt-qa-product-link" onclick="closeQuickAdd()">';
        if(imgUrl) {
          headerHtml += '<img src="' + imgUrl + '" class="tt-qa-prod-img" alt="' + title + '">';
        }
        headerHtml += '<div class="tt-qa-prod-info">';
        headerHtml += '<span class="tt-qa-prod-vendor">' + vendor + '</span>';
        headerHtml += '<h4 class="tt-qa-prod-title">' + title + '</h4>';
        if(descText) {
          headerHtml += '<div class="tt-qa-prod-desc">' + descText + '</div>';
        }
        headerHtml += '</div>';
        headerHtml += '</a>';
        headerHtml += '<a href="' + productUrl + '" class="tt-qa-view-product" onclick="closeQuickAdd()">View full details</a>';
        
        document.getElementById('tt-qa-header-product').innerHTML = headerHtml;

        // Build Variant Selector + Single CTA
        const selectedVariant = product.variants.find(v => v.available) || product.variants[0];
        currentQuickAddVariantId = selectedVariant ? selectedVariant.id : null;

        let vHtml = '';
        if (selectedVariant) {
          vHtml += '<div class="tt-qa-meta">';
          vHtml += '<span class="tt-qa-price" id="tt-qa-current-price">' + formatQuickAddMoney(selectedVariant.price) + '</span>';
          vHtml += '</div>';
        }

        const showVariantChoices = product.variants.length > 1 || (product.variants[0] && product.variants[0].title !== 'Default Title');
        if (showVariantChoices) {
          vHtml += '<div class="tt-qa-size-selector">';
          vHtml += '<span class="tt-qa-size-label">Size</span>';
          vHtml += '<div class="tt-qa-variant-pills">';
          product.variants.forEach(v => {
            const label = v.title === 'Default Title' ? 'Standard Size' : v.title;
            const isSelected = selectedVariant && v.id === selectedVariant.id;
            const activeClass = isSelected ? ' is-active' : '';
            const disabledClass = v.available ? '' : ' is-disabled';
            vHtml += '<button type="button" class="tt-qa-variant-pill' + activeClass + disabledClass + '" data-variant-id="' + v.id + '" data-price="' + v.price + '" data-available="' + v.available + '" onclick="syncQuickAddVariantUI(this)">' + label + '</button>';
          });
          vHtml += '</div>';
          vHtml += '</div>';
        }

        const canAdd = selectedVariant && selectedVariant.available;
        vHtml += '<button type="button" class="tt-qa-add-btn" id="tt-qa-add-btn" onclick="addVariantToCart()"' + (canAdd ? '' : ' disabled') + '>' + (canAdd ? 'Add To Bag' : 'Sold Out') + '</button>';
        document.getElementById('tt-qa-variants').innerHTML = vHtml;

        syncQuickAddVariantUI(document.querySelector('.tt-qa-variant-pill.is-active') || document.querySelector('.tt-qa-variant-pill:not(.is-disabled)'));
      });
  }
  function addVariantToCart(id = currentQuickAddVariantId) {
    if (!id) return;
    const btn = document.getElementById('tt-qa-add-btn');
    if (btn) {
      btn.innerText = 'ADDING...';
      btn.style.opacity = '0.7';
      btn.disabled = true;
    }
    
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: id, quantity: 1, sections: 'ayus-cart-drawer' })
    })
    .then(res => res.json())
    .then(data => {
      if (btn) btn.innerText = 'ADDED';
      closeQuickAdd();
      if (data.sections && data.sections['ayus-cart-drawer']) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(data.sections['ayus-cart-drawer'], 'text/html');
        const newDrawerWrapper = doc.querySelector('.tt-cart-drawer-wrapper') || doc.body.firstElementChild;
        
        if(newDrawerWrapper) {
          const newPanel = newDrawerWrapper.querySelector('.tt-cart-panel');
          const oldPanel = document.querySelector('.tt-cart-panel');
          if(newPanel && oldPanel) oldPanel.innerHTML = newPanel.innerHTML;
          
          const cartDrawer = document.getElementById('tt-cart-drawer');
          if (cartDrawer && !cartDrawer.classList.contains('is-open')) {
            cartDrawer.classList.add('is-open');
          }
          
          const newCount = newDrawerWrapper.querySelector('#shopify-section-cart-drawer')?.getAttribute('data-cart-count') || newDrawerWrapper.getAttribute('data-cart-count');
          const countElements = document.querySelectorAll('.ayus-cart-link');
          countElements.forEach(el => {
            if(el.querySelector('.tt-cart-badge')) { el.querySelector('.tt-cart-badge').innerText = newCount || document.querySelector('.tt-cart-drawer-wrapper').getAttribute('data-cart-count'); }
          });
        }
      } else {
        refreshBagDrawer();
      }
    })
    .catch(err => {
      console.error(err);
      if (btn) {
        btn.innerText = 'ERROR';
        btn.disabled = false;
        btn.style.opacity = '1';
      }
    });
  }
</script>
