
<section class="ayus-register-page" style="padding: 80px 20px; display: flex; justify-content: center; align-items: flex-start; min-height: 70vh; background: var(--color-background);">
  
  <div class="tt-auth-container" style="max-width: 500px; width: 100%; background: #fff; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid var(--color-border);">
    
    <div style="text-align: center; margin-bottom: 30px;">
      <h1 style="font-family: var(--font-heading); font-size: 32px; margin-bottom: 10px; color: var(--color-text);">Create Account</h1>
      <p style="font-family: var(--font-body); color: #555; font-size: 14px;">Join Tulsi Tales to manage your orders and addresses.</p>
    </div>
    
    {% form 'create_customer' %}
      {% if form.errors %}
        <div style="background: #fdf2f2; color: #d32f2f; padding: 15px; margin-bottom: 20px; font-size: 13px; border: 1px solid #f5c6c6;">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      
      <div style="display: flex; gap: 15px; margin-bottom: 20px;">
        <div style="flex: 1;">
          <label for="FirstName" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 8px;">First Name</label>
          <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;">
        </div>
        <div style="flex: 1;">
          <label for="LastName" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 8px;">Last Name</label>
          <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;">
        </div>
      </div>

      <div style="margin-bottom: 20px;">
        <label for="Email" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 8px;">Email Address</label>
        <input type="email" name="customer[email]" id="Email" autocomplete="email" autocorrect="off" autocapitalize="off" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;" required>
      </div>

      <div style="margin-bottom: 30px;">
        <label for="CreatePassword" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 8px;">Password</label>
        <input type="password" name="customer[password]" id="CreatePassword" autocomplete="new-password" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;" required>
      </div>

      <button type="submit" class="ayus-btn" style="width: 100%; margin-bottom: 20px;">Create Account</button>
      
      <div style="text-align: center; font-size: 13px; color: #666;">
        Already have an account? <a href="/account/login" style="color: var(--color-accent); text-decoration: underline;">Sign in instead</a>
      </div>
    {% endform %}
    
  </div>
</section>

{% schema %}
{
  "name": "Register Layout",
  "settings": []
}
{% endschema %}
