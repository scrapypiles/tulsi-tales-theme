
<section class="ayus-page-section" style="padding: 80px 20px; max-width: 800px; margin: 0 auto;">
  <div class="ayus-container">
    <h1 style="font-family: var(--font-heading); font-size: 42px; text-align: center; margin-bottom: 40px;">{{ page.title }}</h1>
    <div class="ayus-page-content rte" style="font-family: var(--font-body); line-height: 1.8; color: var(--color-text);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Default Page",
  "settings": []
}
{% endschema %}
