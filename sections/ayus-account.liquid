
<section class="ayus-account-dashboard" style="padding: 60px 20px; background: var(--color-background); min-height: 70vh;">
  <div class="ayus-container" style="max-width: 1000px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; border-bottom: 1px solid var(--color-border); padding-bottom: 20px;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 36px; margin: 0 0 10px 0; color: var(--color-text);">My Account</h1>
        <p style="font-size: 14px; color: #666; margin: 0;">Welcome back, {{ customer.first_name }}!</p>
      </div>
      <a href="/account/logout" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); text-decoration: underline;">Log out</a>
    </div>

    <div style="display: flex; gap: 40px;">
      
      <!-- Order History -->
      <div style="flex: 2;">
        <h2 style="font-family: var(--font-heading); font-size: 24px; margin-bottom: 20px;">Order History</h2>
        
        {% paginate customer.orders by 20 %}
          {% if customer.orders.size > 0 %}
            <table style="width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--color-border); font-family: var(--font-body); font-size: 13px;">
              <thead style="background: #fdfcf9; border-bottom: 1px solid var(--color-border); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; color: #888;">
                <tr>
                  <th style="padding: 15px; text-align: left;">Order</th>
                  <th style="padding: 15px; text-align: left;">Date</th>
                  <th style="padding: 15px; text-align: left;">Payment Status</th>
                  <th style="padding: 15px; text-align: left;">Fulfillment Status</th>
                  <th style="padding: 15px; text-align: right;">Total</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr style="border-bottom: 1px solid var(--color-border);">
                    <td style="padding: 15px;"><a href="{{ order.customer_url }}" style="color: var(--color-accent); text-decoration: underline; font-weight: bold;">{{ order.name }}</a></td>
                    <td style="padding: 15px;">{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td style="padding: 15px;">{{ order.financial_status_label }}</td>
                    <td style="padding: 15px;">{{ order.fulfillment_status_label }}</td>
                    <td style="padding: 15px; text-align: right;">{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}
            <div style="background: #fff; padding: 40px; border: 1px solid var(--color-border); text-align: center;">
              <p style="color: #666; margin-bottom: 20px;">You haven't placed any orders yet.</p>
              <a href="/collections/all" class="ayus-btn-outline">Browse Apothecary</a>
            </div>
          {% endif %}
          
          {% if paginate.pages > 1 %}
            <div style="margin-top: 20px;">{{ paginate | default_pagination }}</div>
          {% endif %}
        {% endpaginate %}
      </div>

      <!-- Account Details / Addresses -->
      <div style="flex: 1; min-width: 250px;">
        <h2 style="font-family: var(--font-heading); font-size: 24px; margin-bottom: 20px;">Account Details</h2>
        <div style="background: #fff; padding: 25px; border: 1px solid var(--color-border);">
          <p style="margin: 0 0 5px 0; font-weight: bold; color: var(--color-text);">{{ customer.name }}</p>
          <p style="margin: 0 0 20px 0; font-size: 13px; color: #666;">{{ customer.email }}</p>
          
          <div style="font-size: 13px; line-height: 1.6; color: #555;">
            {{ customer.default_address | format_address }}
          </div>
          
          <a href="/account/addresses" class="ayus-btn" style="display: block; text-align: center; margin-top: 20px; font-size: 11px; padding: 12px 20px;">Manage Addresses ({{ customer.addresses_count }})</a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account Dashboard",
  "settings": []
}
{% endschema %}
