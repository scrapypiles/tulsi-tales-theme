
<section class="ayus-login-page" style="padding: 80px 20px; display: flex; justify-content: center; align-items: flex-start; min-height: 70vh; background: var(--color-background);">
  
  <div class="tt-auth-container" style="max-width: 900px; width: 100%; display: flex; gap: 40px; background: #fff; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid var(--color-border);">
    
    <!-- Left Side: Login Form -->
    <div class="tt-auth-form" style="flex: 1; padding-right: 40px; border-right: 1px solid var(--color-border);">
      <h1 style="font-family: var(--font-heading); font-size: 32px; margin-bottom: 10px; color: var(--color-text);">Welcome Back</h1>
      <p style="font-family: var(--font-body); color: #555; margin-bottom: 30px; font-size: 14px;">Access your apothecary, track your orders, and manage your rituals.</p>
      
      {% form 'customer_login' %}
        {% if form.errors %}
          <div style="background: #fdf2f2; color: #d32f2f; padding: 15px; margin-bottom: 20px; font-size: 13px; border: 1px solid #f5c6c6;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        
        <div style="margin-bottom: 20px;">
          <label for="CustomerEmail" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 8px;">Email Address</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;" required>
        </div>

        {% if form.password_needed %}
          <div style="margin-bottom: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <label for="CustomerPassword" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #888;">Password</label>
              <a href="#recover" style="font-size: 12px; color: var(--color-accent); text-decoration: underline;">Forgot password?</a>
            </div>
            <input type="password" value="" name="customer[password]" id="CustomerPassword" autocomplete="current-password" style="width: 100%; padding: 12px 15px; border: 1px solid var(--color-border); font-family: var(--font-body); box-sizing: border-box;" required>
          </div>
        {% endif %}

        <button type="submit" class="ayus-btn" style="width: 100%; margin-bottom: 20px;">Sign In</button>
      {% endform %}
    </div>

    <!-- Right Side: Value Props / Registration CTA -->
    <div class="tt-auth-info" style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
      <h2 style="font-family: var(--font-heading); font-size: 24px; margin-bottom: 20px;">New to Tulsi Tales?</h2>
      <p style="font-family: var(--font-body); color: #555; margin-bottom: 30px; font-size: 14px; line-height: 1.6;">Create an account to securely save your shipping addresses, check out faster, and access your complete order history in one place.</p>
      
      <ul style="list-style: none; padding: 0; margin: 0 0 30px 0;">
        <li style="display: flex; align-items: center; margin-bottom: 15px; font-size: 13px; color: #444;">
          <span style="color: var(--color-accent); margin-right: 10px; font-size: 18px;">✓</span> Track your orders instantly
        </li>
        <li style="display: flex; align-items: center; margin-bottom: 15px; font-size: 13px; color: #444;">
          <span style="color: var(--color-accent); margin-right: 10px; font-size: 18px;">✓</span> Save multiple shipping addresses
        </li>
        <li style="display: flex; align-items: center; font-size: 13px; color: #444;">
          <span style="color: var(--color-accent); margin-right: 10px; font-size: 18px;">✓</span> Faster checkout experience
        </li>
      </ul>

      <a href="/account/register" class="ayus-btn-outline" style="text-align: center;">Create Account</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Login Layout",
  "settings": []
}
{% endschema %}
